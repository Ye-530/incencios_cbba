# Entorno virtual y dependencias
.venv/
build/
*.egg-info/

# Configuraciones de IDEs
.idea/
.vscode/

# Temporales de Python y pruebas
__pycache__/
*.pyc
.pytest_cache/
.superpowers/

# Credenciales y claves privadas (NUNCA subir a GitHub)
credenciales.json
*.key
*.token
.env*

# Resultados de versiones anteriores
salidas/

# Predicciones del modelo (archivos generados de 69-71 MB, se recrean con 'entrenar')
data/processed/predicciones/
# Muestra de entrenamiento (~1 GB): la rehace 'python -m incendios preparar' en unos minutos
data/processed/muestra/
# Modelos de la ablación: solo sirven para la tabla de ablación de 'evaluar'
models/ablacion/
